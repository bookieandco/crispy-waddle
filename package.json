{
  "name": "jhadina",
  "version": "0.1.0",
  "description": "A unified personal AI operating system with multiple intelligence layers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.10.7",
    "typescript": "^5.1.0"
  },
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.15.9"
  },
  "pnpm": {
    "packageExtensions": {
      "@react-three/fiber": {
        "dependencies": {
          "@types/react": "19.2.18"
        }
      },
      "@react-three/drei": {
        "dependencies": {
          "@types/react": "19.2.18"
        }
      },
      "framer-motion@11.18.2": {
        "dependencies": {
          "@types/react": "19.2.18"
        }
      },
      "next@15.5.23": {
        "dependencies": {
          "@types/react": "19.2.18",
          "@types/react-dom": "19.2.4"
        }
      },
      "next@14.2.35": {
        "dependencies": {
          "@types/react": "18.3.31",
          "@types/react-dom": "18.3.7"
        }
      }
    }
  }
}
