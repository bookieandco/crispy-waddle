# Public app URL used to construct OAuth callbacks in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase SSR/Auth configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only service-role key backing SupabaseMemoryStorage (see
# src/lib/supabase/service-role.ts and
# supabase/migrations/20260822000000_create_jhadina_memory_core.sql).
# Never expose with a NEXT_PUBLIC_ prefix. When unset, the app falls back
# to InMemoryStorage and logs a warning instead of failing.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth 2.0 Web Application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional explicit callback URL. Set this in production when the public URL differs.
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# 32+ bytes of random secret material used to encrypt OAuth tokens at rest in httpOnly cookies.
JHADINA_OAUTH_ENCRYPTION_KEY=

# Commerce sandbox-payment milestone (PL-3/PL-6): a Stripe *test-mode*
# secret key. Resolved server-side only.
JHADINA_SECRET_STRIPE_SANDBOX=

# Intelligence Router: server-side Anthropic API key.
ANTHROPIC_API_KEY=

# SAM.gov Contract Opportunities public API key.
# Server-side only: NEVER prefix with NEXT_PUBLIC_, commit a real value,
# expose it to the browser, or pass it to an LLM.
SAM_GOV_API_KEY=
