{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/types/**/*.d.ts",
    "src/lib/social/**/*.ts",
    "src/lib/growth/**/*.ts",
    "src/lib/intelligence/ask-social-command.ts",
    "src/lib/intelligence/ask-social-command.test.ts",
    "src/lib/context/context-builder.ts",
    "src/lib/context/production-social-context-provider.ts",
    "src/lib/context/production-social-context-provider.test.ts",
    "src/lib/context/social-context.integration.test.ts",
    "src/app/api/jhadina/command/route.ts",
    "src/app/api/jhadina/command/route.social.test.ts",
    "src/app/ask-jhadina/page.tsx",
    "src/app/api/social/**/*.ts",
    "src/app/api/growth/**/*.ts",
    "src/app/social/**/*.tsx",
    "src/app/growth/**/*.tsx",
    "components/home/*.ts",
    "components/home/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist"
  ]
}
