{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/lib/social/**/*.ts",
    "src/lib/growth/**/*.ts",
    "src/app/api/social/**/*.ts",
    "src/app/api/growth/**/*.ts",
    "src/app/social/**/*.tsx",
    "src/app/growth/**/*.tsx",
    "components/home/*.ts",
    "components/home/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist"
  ]
}
