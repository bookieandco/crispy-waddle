# Example only; never installed or enabled by this PR.
[Unit]
Description=Jhadina Shadow weekly offline PostgreSQL restoration audit
Wants=network-online.target
After=network-online.target
AssertPathExists=/etc/jhadina/shadow-google-drive.env

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/jhadina/shadow-google-drive.env
WorkingDirectory=/workspace/jhadina/crispy-waddle
ExecStartPre=/usr/bin/python3 infrastructure/homebase/google-drive/shadow_backup.py doctor
ExecStart=/usr/bin/python3 infrastructure/homebase/google-drive/shadow_archive_cycle.py --mode restore-drill
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
TimeoutStartSec=7200
