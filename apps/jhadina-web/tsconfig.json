{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@jhadina/entertainment-core": [
        "../../packages/jhadina-entertainment-core/src"
      ],
      "@jhadina/action-core": [
        "../../packages/jhadina-action-core/src"
      ],
      "@jhadina/core-spine": [
        "../../packages/jhadina-core-spine/src"
      ],
      "@jhadina/intelligence-core": [
        "../../packages/jhadina-intelligence-core/src"
      ],
      "@jhadina/*": [
        "../../packages/*/src",
        "../../apps/*/src"
      ],
      "@jhadina/capability-registry": [
        "../../packages/jhadina-capability-registry/src"
      ],
      "@jhadina/event-bus": [
        "../../packages/jhadina-event-bus/src"
      ]
    },
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "scripts/local-gov-production-convergence.ts",
    "scripts/local-gov-registry-live-probe.ts",
    "scripts/usac-public-vertical-probe.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist"
  ]
}
