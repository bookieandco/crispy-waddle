{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    ".eslintrc.json"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [
        "dist/**",
        ".next/**"
      ],
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "JHADINA_TV_OWNER_AUTH_USER_ID",
        "JHADINA_PUBLIC_ORIGIN",
        "JHADINA_TV_STREAM_SIGNING_SECRET",
        "JHADINA_TV_JELLYFIN_URL",
        "JHADINA_TV_JELLYFIN_API_KEY",
        "JHADINA_TV_JELLYFIN_USER_ID",
        "JHADINA_TV_JELLYFIN_RIGHTS",
        "JHADINA_TV_JELLYFIN_RIGHTS_EVIDENCE_IDS",
        "JHADINA_TV_JELLYFIN_TERRITORIES",
        "JHADINA_TV_TERRITORY",
        "JHADINA_TV_JELLYFIN_LIVE_STREAM_PATH_TEMPLATE",
        "JHADINA_TV_JELLYFIN_VOD_STREAM_PATH_TEMPLATE",
        "JHADINA_TV_RECEIVER_PAIRING_VERIFIED",
        "JHADINA_TV_RECEIVER_SIGNING_SECRET",
        "JHADINA_TV_RECEIVER_APPROVED_IDS",
        "JHADINA_TV_RECEIVERS"
      ]
    },
    "test": {
      "outputs": [
        "coverage/**"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "outputs": [
        ".eslintcache"
      ]
    },
    "type-check": {
      "cache": true
    },
    "clean": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:seed": {
      "cache": false
    }
  },
  "globalEnv": [
    "JHADINA_GEV_BASE_URL",
    "GEV_BASE_URL"
  ]
}
