{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo run build --filter=@jhadina/jhadina-web",
  "outputDirectory": "apps/jhadina-web/.next",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "npx turbo@2.11.2 query affected --base=$VERCEL_GIT_PREVIOUS_SHA --packages @jhadina/jhadina-web --exit-code"
}
