# Public app URL used to construct OAuth callbacks in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase SSR/Auth configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only service-role key backing SupabaseMemoryStorage (see
# src/lib/supabase/service-role.ts and
# supabase/migrations/20260822000000_create_jhadina_memory_core.sql).
# Never expose with a NEXT_PUBLIC_ prefix. When unset, the app falls back
# to InMemoryStorage and logs a warning instead of failing.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth 2.0 Web Application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional explicit callback URL. Set this in production when the public URL differs.
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# 32+ bytes of random secret material used to encrypt OAuth tokens at rest in httpOnly cookies.
JHADINA_OAUTH_ENCRYPTION_KEY=

# Commerce sandbox-payment milestone (PL-3/PL-6): a Stripe *test-mode*
# secret key. Resolved server-side only.
JHADINA_SECRET_STRIPE_SANDBOX=

# Intelligence Router: server-side Anthropic API key.
ANTHROPIC_API_KEY=

# SAM.gov Contract Opportunities public API key.
# Server-side only: NEVER prefix with NEXT_PUBLIC_, commit a real value,
# expose it to the browser, or pass it to an LLM.
SAM_GOV_API_KEY=

# Protect low-quota SAM Entity API keys. The lowest documented personal-key
# tier is 10 requests/day; with four enrichments/day, default 2 keeps the
# scheduled worker at or below eight Entity API requests/day.
SAM_ENTITY_REQUEST_BUDGET_PER_ENRICHMENT=2

# SHARK / meme-trader server-only provider configuration.
# Protects internal scheduled SHARK workers. Vercel cron requests use this as a Bearer secret.
CRON_SECRET=

# Canonical public Jhadina origin used only to verify the registered Helius launch webhook.\n# Example: https://crispy-waddle-jhadina-web.vercel.app\nSHARK_PUBLIC_ORIGIN=\n\n# Helius enhanced webhook authentication secret configured for the launch-ingestion webhook.\nHELIUS_WEBHOOK_SECRET=

# Solana JSON-RPC used by the wallet-intelligence route.
# SOLANA_RPC_URL takes precedence when both are configured.
SOLANA_RPC_URL=
HELIUS_RPC_URL=

# Provider keys used only by SHARK historical backfill workers.
HELIUS_API_KEY=
COINGECKO_API_KEY=

# Optional Arkham wallet enrichment. Both values are required to enable this source.
ARKHAM_WALLET_ENDPOINT=
ARKHAM_API_KEY=


# Bound requirement-level USAspending provider searches per enrichment run.
# This protects runtime duration while allowing NAICS, PSC, and keyword paths.
USASPENDING_REQUEST_BUDGET_PER_ENRICHMENT=6


# Mexico provider discovery via INEGI DENUE.
# Server-side only. DENUE requires a registered API token.
INEGI_DENUE_TOKEN=
DENUE_SEARCH_BUDGET_PER_ENRICHMENT=2

# Canada provider discovery.
# Current ISED product reports are preferred for named major importers. The
# 2022 CSVs remain a machine-readable historical fallback and HS6 vocabulary.
CANADA_CID_HS6_DESCRIPTION_URL=https://ised-isde.canada.ca/site/ised/sites/default/files/documents/cid-bdic-hs6description2022.csv
CANADA_CID_IMPORTERS_HS6_URL=https://ised-isde.canada.ca/site/ised/sites/default/files/documents/cid-bdic-majorimportersbyhs62022.csv
CANADA_CID_LIVE_HS6_LIMIT=2
CANADA_SEARCH_BUDGET_PER_ENRICHMENT=2

# Optional pre-extracted CSV mirror of Statistics Canada's Open Database of
# Businesses. The official source is a ~450k-record bulk archive; do not download
# that archive inside every SAM enrichment run. Leave unset until a cached
# catalog/import worker provides a CSV endpoint.
CANADA_ODBUS_CSV_URL=


# U.S. logistics provider discovery via the public FMCSA Company Census File.
# FMCSA_APP_TOKEN is optional for higher Socrata API limits.
FMCSA_APP_TOKEN=
FMCSA_SEARCH_BUDGET_PER_ENRICHMENT=2

# U.S. meat/poultry/egg establishment discovery via USDA FSIS public CSVs.
# FSIS publishes the MPI directory and demographic supplement as downloadable
# CSVs from its official inspection-directory page. Configure the current direct
# CSV URLs here rather than scraping the interactive page.
FSIS_MPI_CSV_URL=
FSIS_MPI_DEMOGRAPHIC_CSV_URL=
FSIS_SEARCH_BUDGET_PER_ENRICHMENT=2


# Broad company discovery for providers that may have no federal award history.
# Exa is discovery-only: results do not verify U.S. domicile, legal identity,
# NAICS capability, or eligibility until corroborated by independent evidence.
EXA_API_KEY=
EXA_SEARCH_BUDGET_PER_ENRICHMENT=2

# Additional bounded web corroboration for official Mexico/Canada provider hits.
# Web discovery never verifies country by itself; it can only corroborate an
# official DENUE/Canadian source after exact name/domain reconciliation.
EXA_FOREIGN_CORROBORATION_BUDGET_PER_ENRICHMENT=2
