# Jhadina native voice service runtime.
# Never commit real tokens or private reference audio.

JHADINA_VOICE_TOKEN=

# Native TTS lane 1.
JHADINA_QWEN3_TTS_URL=
JHADINA_QWEN3_TTS_TOKEN=
JHADINA_QWEN3_TTS_MODEL_ID=
JHADINA_QWEN3_TTS_VOICE_REF=
JHADINA_QWEN3_TTS_LANGUAGES=en-US

# Native TTS lane 2.
JHADINA_VOXCPM2_TTS_URL=
JHADINA_VOXCPM2_TTS_TOKEN=
JHADINA_VOXCPM2_TTS_MODEL_ID=
JHADINA_VOXCPM2_TTS_VOICE_REF=
JHADINA_VOXCPM2_TTS_LANGUAGES=en-US

# Canonical identity. Keep candidate until the exact reference sample has
# passed the JHADINA-VOICE.6 fingerprint + explicit approval flow.
JHADINA_VOICE_IDENTITY_ID=voice:jhadina:canonical:v1
JHADINA_VOICE_IDENTITY_STATUS=candidate
JHADINA_VOICE_APPROVAL_RECEIPT_ID=
JHADINA_VOICE_APPROVAL_RECEIPT_PATH=

# Read-only path to the exact approved reference audio on the private runtime.
JHADINA_VOICE_REFERENCE_PATH=
JHADINA_VOICE_REFERENCE_MIME=audio/wav
JHADINA_VOICE_REFERENCE_SHA256=
JHADINA_VOICE_MIN_SPEAKER_SIMILARITY=0.80

# Reuse the provider-independent ECAPA worker already used by Director/Bonez.
# JHADINA_* names are preferred. DIRECTOR_SPEAKER_QC_URL/TOKEN are accepted
# as backward-compatible fallbacks when the same private worker is shared.
JHADINA_SPEAKER_QC_URL=
JHADINA_SPEAKER_QC_TOKEN=
JHADINA_SPEAKER_QC_MODEL_ID=speechbrain/spkrec-ecapa-voxceleb
JHADINA_SPEAKER_QC_MODEL_REVISION=ff989f88e92ccc120569763824f8eedd5afc9039

# ASR.
JHADINA_WHISPER_MODEL=small
JHADINA_WHISPER_DEVICE=auto
JHADINA_WHISPER_COMPUTE=int8
