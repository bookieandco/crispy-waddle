# Optional. Without this, FunFinder falls back to MockPlacesProvider and
# every result is labeled providerName="mock_offline" (see
# packages/truckeros-core/src/providers/index.ts). Set this to search real
# places via Google Places (New) Text Search.
GOOGLE_MAPS_API_KEY=

# Not read by the app yet — reserved for when PostgresPlaceRepository /
# PostgresDriverRepository etc. get wired in place of the in-memory
# repositories the composition root uses today.
DATABASE_URL=
