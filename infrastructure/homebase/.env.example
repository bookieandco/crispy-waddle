# Jhadina Homebase canonical infrastructure.
# Copy to a secret local .env file. Never commit real credentials.

JHADINA_DATA_ROOT=/srv/jhadina
JHADINA_BACKUP_ROOT=/srv/jhadina-backups

JHADINA_POSTGRES_DB=jhadina
JHADINA_POSTGRES_USER=jhadina
JHADINA_POSTGRES_PASSWORD=replace-me
JHADINA_POSTGRES_PORT=5432
DATABASE_URL=postgresql://jhadina:replace-me@127.0.0.1:5432/jhadina

JHADINA_MINIO_ROOT_USER=jhadina
JHADINA_MINIO_ROOT_PASSWORD=replace-me
JHADINA_MINIO_API_PORT=9000
JHADINA_MINIO_CONSOLE_PORT=9001
JHADINA_OBJECT_STORE_URL=http://127.0.0.1:9000

JHADINA_VALKEY_PORT=6379
JHADINA_CACHE_URL=redis://127.0.0.1:6379

JHADINA_NATS_PORT=4222
JHADINA_NATS_MONITOR_PORT=8222
JHADINA_QUEUE_URL=nats://127.0.0.1:4222

# RunPod is research/burst execution only. Keep the real key in the Homebase secret store.
RUNPOD_API_KEY=
RUNPOD_RESEARCH_POD_PROXY_URL=
RUNPOD_GPU_ENDPOINT_ID=
