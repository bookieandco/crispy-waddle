# Example only. A failed unit is NOT proof of a delivered phone alert.
[Unit]
Description=Check age of SHADOW encrypted Google Drive snapshot receipts

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/jhadina/shadow-google-drive.env
WorkingDirectory=/workspace/jhadina/crispy-waddle
ExecStart=/usr/bin/python3 infrastructure/homebase/google-drive/shadow_drive_monitor.py --max-age-hours 36
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
