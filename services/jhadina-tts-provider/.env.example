# One process = one isolated provider lane. Never commit real tokens.
JHADINA_TTS_TOKEN=
# qwen3-tts | voxcpm2
JHADINA_TTS_PROVIDER=qwen3-tts
# design is audition-only; clone is the production-capable mode.
JHADINA_TTS_MODE=clone
JHADINA_TTS_MODEL_ID=
JHADINA_TTS_VOICE_REF=
JHADINA_TTS_DEVICE=cuda:0

# Clone mode requires the exact approved immutable reference.
JHADINA_TTS_REFERENCE_PATH=/run/secrets/jhadina-voice-reference.wav
JHADINA_TTS_REFERENCE_SHA256=
JHADINA_TTS_REFERENCE_TEXT=

# Optional Qwen attention implementation, e.g. flash_attention_2 when installed.
JHADINA_TTS_ATTN_IMPLEMENTATION=

# Original-designed voice brief; never use a real-person imitation instruction.
JHADINA_TTS_DESIGN_BRIEF=
