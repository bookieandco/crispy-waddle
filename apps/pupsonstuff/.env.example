# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
MUAPI_API_KEY=
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Required for /api/checkout and /api/checkout/session (lib/stripe.ts).
# Use a test-mode secret key (sk_test_...) while developing.
STRIPE_SECRET_KEY=

# Required for /api/stripe/webhook. Create a webhook endpoint for
# /api/stripe/webhook and copy its signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Required for durable PupsonStuff order records written by the Stripe
# webhook. These are server-only values; never expose the service role key
# through a NEXT_PUBLIC_ variable or client component.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
