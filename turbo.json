{
  "$schema": "https://turbo.build/json-schema.json",
  "version": "1",
  "globalDependencies": ["tsconfig.json", ".eslintrc.json"],
  "pipeline": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "cache": true,
      "outputs": [".eslintcache"]
    },
    "type-check": {
      "cache": true
    },
    "clean": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:seed": {
      "cache": false
    }
  }
}
