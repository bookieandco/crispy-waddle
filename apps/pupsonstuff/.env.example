# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Required for /api/generate-preview (lib/ai.ts) — static pet-portrait
# generation via OpenAI's Images API.
OPENAI_API_KEY=

# Required for /api/animate-preview (lib/animation.ts) — turns an
# already-generated static portrait into a short looping video via
# Hugging Face's image-to-video task. Create a token at
# https://hf.co/settings/tokens (read access is enough).
HUGGINGFACE_API_KEY=

# Required for the "Studio Ghibli" and "Flux Dreamscape" art styles only
# (lib/muapi.ts) — a second, independent image-generation provider from
# OpenAI, used for two styles OpenAI's gpt-image-1 doesn't cleanly
# reproduce. Every other style still only needs OPENAI_API_KEY above; this
# is additive, not a replacement. Get a key at https://muapi.ai (pricing/
# free-tier details weren't reachable to verify from this project's build
# environment — check your own dashboard before assuming a cost).
MUAPI_API_KEY=

# Required for the production fulfillment path. Storefront identifiers are
# provider-neutral; certified live provider mappings are persisted in
# pupson_catalog_variants. Generate a personal access token in Printify.
PRINTIFY_API_KEY=
# Every products/orders/uploads endpoint is scoped to one shop
# (/v1/shops/{shop_id}/...) — there's no single "current shop" concept
# in the API itself, so this isn't read by lib/printify.ts automatically;
# it's here as the value a caller should pass in. Find yours via
# listShops() in lib/printify.ts, or your Printify dashboard URL.
PRINTIFY_SHOP_ID=

# Durable private assets, pet identities, creative jobs, orders, and
# fulfillment ledger. Service role is server-only; never expose it through a
# NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout and signed paid-order webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUPSON_PUBLIC_ORIGIN=http://localhost:3000

# Authenticated staff console. Use long random values in production.
PUPSON_ADMIN_USERNAME=
PUPSON_ADMIN_PASSWORD=
PUPSON_ADMIN_SESSION_SECRET=

# `dry_run` validates and records the fulfillment request without buying
# production. Set to `live` only after sample-order certification.
PUPSON_FULFILLMENT_MODE=dry_run
PUPSON_PRINTIFY_WEBHOOK_SECRET=


# Creative queue catch-up worker. Vercel Cron supplies this as a Bearer token
# when CRON_SECRET is configured. Use at least 32 random characters.
CRON_SECRET=

# Background removal is the default preprocessing behavior for pet uploads.
# Choose one provider. "backgroundremover" is the self-hosted
# nadermx/backgroundremover-compatible HTTP service; "knockout" is a
# BiRefNet-compatible hosted/self-hosted API.
PUPSON_BACKGROUND_REMOVER_PROVIDER=backgroundremover

# Self-hosted backgroundremover endpoint. Keep it private/restricted; the
# upstream demo server itself does not provide authentication.
PUPSON_BACKGROUND_REMOVER_URL=
PUPSON_BACKGROUND_REMOVER_MODEL=u2net
PUPSON_BACKGROUND_REMOVER_TOKEN=

# Alternative BiRefNet provider.
KNOCKOUT_TOKEN=
PUPSON_KNOCKOUT_URL=https://useknockout--api.modal.run/remove
