# Public app URL used to construct OAuth callbacks in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase SSR/Auth configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only service-role key backing SupabaseMemoryStorage (see
# src/lib/supabase/service-role.ts and
# supabase/migrations/20260822000000_create_jhadina_memory_core.sql).
# Never expose with a NEXT_PUBLIC_ prefix. Production fails closed when this
# durable Memory dependency is absent; InMemoryStorage is dev/test only.
SUPABASE_SERVICE_ROLE_KEY=

# Memory persistence provider.
# - auto: current Supabase-first compatibility behavior.
# - supabase: require direct Supabase service-role storage.
# - oidc_gateway: force the bounded Vercel-OIDC MemoryStorage gateway even while
#   legacy Supabase keys remain configured during migration.
JHADINA_MEMORY_STORAGE_PROVIDER=auto

# Production Vercel-OIDC durable Memory gateway.
# Vercel provides VERCEL_OIDC_TOKEN automatically at runtime; never set it manually.
# Portable RunPod staging uses:
#   https://<pod-id>-8095.proxy.runpod.net/v1/memory
JHADINA_MEMORY_GATEWAY_URL=https://kqbkaozfjubkjevdfvic.supabase.co/functions/v1/jhadina-memory-gateway

# Optional Music restoration overrides. Production defaults to the existing
# Director Hunyuan worker URL/token and appends /music-restoration to that URL.
# Vercel OIDC remains a lower-priority fallback when project OIDC is enabled.
# Set these only for alternate/manual worker deployments.
MUSIC_RESTORATION_WORKER_URL=
MUSIC_RESTORATION_WORKER_TOKEN=

# JhadinaTV authorized Jellyfin / Homebase provider.
# Server-side only unless explicitly marked public. Never expose the API key.
# The provider remains disabled unless HTTPS URL + API key + user id + playback
# right + rights evidence are all present.
JHADINA_TV_JELLYFIN_URL=
JHADINA_TV_JELLYFIN_API_KEY=
JHADINA_TV_JELLYFIN_USER_ID=
JHADINA_PUBLIC_ORIGIN=
JHADINA_TV_JELLYFIN_RIGHTS=playback,casting
JHADINA_TV_JELLYFIN_RIGHTS_EVIDENCE_IDS=
JHADINA_TV_JELLYFIN_TERRITORIES=
JHADINA_TV_TERRITORY=
# Optional Jellyfin-server-specific stream templates. Use {id} as the media id placeholder.
JHADINA_TV_JELLYFIN_LIVE_STREAM_PATH_TEMPLATE=/LiveTv/Channels/{id}/stream
JHADINA_TV_JELLYFIN_VOD_STREAM_PATH_TEMPLATE=/Videos/{id}/stream

# Google Cloud OAuth 2.0 Web Application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional explicit callback URL. Set this in production when the public URL differs.
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# 32+ bytes of random secret material used to encrypt OAuth tokens at rest in httpOnly cookies.
JHADINA_OAUTH_ENCRYPTION_KEY=

# Commerce sandbox-payment milestone (PL-3/PL-6): a Stripe *test-mode*
# secret key. Resolved server-side only.
JHADINA_SECRET_STRIPE_SANDBOX=

# Intelligence Router: server-side Anthropic API key.
ANTHROPIC_API_KEY=

# SAM.gov Contract Opportunities public API key.
# Server-side only: NEVER prefix with NEXT_PUBLIC_, commit a real value,
# expose it to the browser, or pass it to an LLM.
SAM_GOV_API_KEY=

# Protect low-quota SAM Entity API keys. The lowest documented personal-key
# tier is 10 requests/day; with four enrichments/day, default 2 keeps the
# scheduled worker at or below eight Entity API requests/day.
SAM_ENTITY_REQUEST_BUDGET_PER_ENRICHMENT=2

# SHARK / meme-trader server-only provider configuration.
# Protects internal scheduled SHARK workers. Vercel cron requests use this as a Bearer secret.
CRON_SECRET=

# Provider-neutral web search used by governed research/discovery adapters.
# Server-side only. The endpoint must accept q/freshness query parameters and
# return JSON shaped as { results: [{ title, url, snippet, publishedAt? }] }.
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=

# Etsy Open API v3 read-only marketplace intelligence.
# Server-side only. Format required by Etsy: <keystring>:<shared_secret>.
# Venture Factory uses public active-listing + public shop reads only; it does
# not fetch competitor creative assets, mutate listings, or claim per-listing sales.
ETSY_API_KEY=

# National public-procurement source commissioning.
# Search results are discovery-only until official jurisdiction evidence corroborates them.
LOCAL_GOV_SOURCE_DISCOVERY_BATCH_SIZE=12
LOCAL_GOV_SOURCE_DISCOVERY_QUERY_BUDGET=3

# Optional dedicated secret for internal research endpoints such as
# /api/internal/research/source-discovery. When unset, those routes fall back
# to CRON_SECRET. Prefer a distinct value when OverageOS runs as a separate service.
JHADINA_INTERNAL_RESEARCH_SECRET=


# Canonical public Jhadina origin used only to verify the registered Helius launch webhook.\n# Example: https://crispy-waddle-jhadina-web.vercel.app\nSHARK_PUBLIC_ORIGIN=\n\n# Helius enhanced webhook authentication secret configured for the launch-ingestion webhook.\nHELIUS_WEBHOOK_SECRET=

# Solana JSON-RPC used by wallet intelligence and DEX controlled-canary verification.
# Server-side only when it contains a provider credential. HTTPS is required for DEX live readiness.
SOLANA_RPC_URL=
HELIUS_RPC_URL=

# DEX controlled-canary commissioning.
# Never expose any of these with NEXT_PUBLIC_. The readiness API returns presence only, never values.
JUPITER_API_KEY=
MONEY_DEX_COFFER_SIGNER_URL=
MONEY_DEX_COFFER_SIGNER_AUTH=
# Canonical settlement mint, e.g. a verified USDC mint selected for the canary.
MONEY_DEX_SETTLEMENT_MINT=
# Minimum verified wallet balances required before the live canary can start.
# Atomic settlement units and lamports respectively; choose deliberately small canary limits.
MONEY_DEX_CANARY_MIN_SETTLEMENT_ATOMIC=
MONEY_DEX_CANARY_MIN_SOL_LAMPORTS=

# Provider keys used only by SHARK historical backfill workers.
HELIUS_API_KEY=
COINGECKO_API_KEY=

# Optional Arkham wallet enrichment. Both values are required to enable this source.
ARKHAM_WALLET_ENDPOINT=
ARKHAM_API_KEY=


# Bound requirement-level USAspending provider searches per enrichment run.
# This protects runtime duration while allowing NAICS, PSC, and keyword paths.
USASPENDING_REQUEST_BUDGET_PER_ENRICHMENT=6


# Mexico provider discovery via INEGI DENUE.
# Server-side only. DENUE requires a registered API token.
INEGI_DENUE_TOKEN=
DENUE_SEARCH_BUDGET_PER_ENRICHMENT=2

# Canada provider discovery.
# Current ISED product reports are preferred for named major importers. The
# 2022 CSVs remain a machine-readable historical fallback and HS6 vocabulary.
CANADA_CID_HS6_DESCRIPTION_URL=https://ised-isde.canada.ca/site/ised/sites/default/files/documents/cid-bdic-hs6description2022.csv
CANADA_CID_IMPORTERS_HS6_URL=https://ised-isde.canada.ca/site/ised/sites/default/files/documents/cid-bdic-majorimportersbyhs62022.csv
CANADA_CID_LIVE_HS6_LIMIT=2
CANADA_SEARCH_BUDGET_PER_ENRICHMENT=2

# Optional pre-extracted CSV mirror of Statistics Canada's Open Database of
# Businesses. The official source is a ~450k-record bulk archive; do not download
# that archive inside every SAM enrichment run. Leave unset until a cached
# catalog/import worker provides a CSV endpoint.
CANADA_ODBUS_CSV_URL=


# U.S. logistics provider discovery via the public FMCSA Company Census File.
# FMCSA_APP_TOKEN is optional for higher Socrata API limits.
FMCSA_APP_TOKEN=
FMCSA_SEARCH_BUDGET_PER_ENRICHMENT=2

# U.S. meat/poultry/egg establishment discovery via USDA FSIS public CSVs.
# FSIS publishes the MPI directory and demographic supplement as downloadable
# CSVs from its official inspection-directory page. Configure the current direct
# CSV URLs here rather than scraping the interactive page.
FSIS_MPI_CSV_URL=
FSIS_MPI_DEMOGRAPHIC_CSV_URL=
FSIS_SEARCH_BUDGET_PER_ENRICHMENT=2


# Broad company discovery for providers that may have no federal award history.
# Exa is discovery-only: results do not verify U.S. domicile, legal identity,
# NAICS capability, or eligibility until corroborated by independent evidence.
EXA_API_KEY=
EXA_SEARCH_BUDGET_PER_ENRICHMENT=2

# Additional bounded web corroboration for official Mexico/Canada provider hits.
# Web discovery never verifies country by itself; it can only corroborate an
# official DENUE/Canadian source after exact name/domain reconciliation.
EXA_FOREIGN_CORROBORATION_BUDGET_PER_ENRICHMENT=2


# Director autonomous video + private reference-character media.
# Character uploads remain quarantined until DIRECTOR_MEDIA_SCANNER_URL returns
# malware-clean + image-safe evidence. Never expose scanner/provider tokens.
DIRECTOR_MEDIA_SCANNER_URL=
DIRECTOR_MEDIA_SCANNER_TOKEN=

# Reference-aware full-video runtime. This service must preserve the supplied
# Cast Bible reference and implement POST /jobs, GET/DELETE /jobs/:id and
# GET /jobs/:id/output.
DIRECTOR_REFERENCE_VIDEO_PROVIDER_URL=
DIRECTOR_REFERENCE_VIDEO_PROVIDER_TOKEN=
DIRECTOR_REFERENCE_VIDEO_PROVIDER_ID=reference-video-local
DIRECTOR_REFERENCE_VIDEO_PROVIDER_NAME=Reference Character Video
# free-local | external-free | paid; paid remains behind Director spend approval.
DIRECTOR_REFERENCE_VIDEO_PROVIDER_COST_CLASS=free-local

# Preferred native path: reuse the existing Director ComfyUI deployment.
# Provide an API-format workflow JSON containing one or more placeholders:
# {{DIRECTOR_PROMPT}}, {{DIRECTOR_REFERENCE_IMAGE}},
# {{DIRECTOR_REFERENCE_IMAGES}}, {{DIRECTOR_CHARACTER_ID}},
# {{DIRECTOR_CONTINUITY_REF}}, {{DIRECTOR_APPEARANCE_VARIANT_ID}},
# {{DIRECTOR_WIDTH}}, {{DIRECTOR_HEIGHT}}, {{DIRECTOR_DURATION_SECONDS}},
# {{DIRECTOR_SEED}}, {{DIRECTOR_JOB_ID}}, {{DIRECTOR_PROJECT_ID}}.
# Director downloads admitted private references and uploads deterministic
# input copies to ComfyUI before queueing this workflow.
DIRECTOR_REFERENCE_COMFYUI_WORKFLOW_JSON=
DIRECTOR_REFERENCE_COMFYUI_PROVIDER_ID=comfyui-reference-video
DIRECTOR_REFERENCE_COMFYUI_PROVIDER_NAME=ComfyUI Reference Video

# Optional generic whole-video shortcuts for videos that do not require a
# locked recurring character.
DIRECTOR_AGNES_VIDEO_URL=
DIRECTOR_AGNES_VIDEO_TOKEN=
DIRECTOR_SHORT_VIDEO_MAKER_URL=
DIRECTOR_SHORT_VIDEO_MAKER_TOKEN=
DIRECTOR_SHORT_VIDEO_VOICE=af_heart

# Product-reference whole-video runtime. This service must preserve supplied
# Product Bible reference views and exact label authority.
DIRECTOR_PRODUCT_VIDEO_PROVIDER_URL=
DIRECTOR_PRODUCT_VIDEO_PROVIDER_TOKEN=
DIRECTOR_PRODUCT_VIDEO_PROVIDER_ID=product-reference-video-local
DIRECTOR_PRODUCT_VIDEO_PROVIDER_NAME=Product Reference Video
DIRECTOR_PRODUCT_VIDEO_PROVIDER_COST_CLASS=free-local


# Jhadina native voice service. Server-side only.
# The web app only needs the private service URL/token. The service runtime itself
# must separately bind the approved acoustic identity, provider voices, and ECAPA QC.
JHADINA_VOICE_URL=
JHADINA_VOICE_TOKEN=

# Native Jhadina voice-service runtime only — do not expose to the browser.
# Candidate/audition runtimes should leave STATUS=candidate and MUST NOT set a fake
# approval receipt. Production /speak remains blocked until the exact approved
# reference bytes + SHA and speaker-QC service are present.
# JHADINA_VOICE_IDENTITY_ID=voice:jhadina:canonical:v1
# JHADINA_VOICE_IDENTITY_STATUS=candidate
# JHADINA_VOICE_APPROVAL_RECEIPT_ID=
# JHADINA_VOICE_REFERENCE_PATH=/run/secrets/jhadina-voice-reference.wav
# JHADINA_VOICE_REFERENCE_MIME=audio/wav
# JHADINA_VOICE_REFERENCE_SHA256=
# JHADINA_VOICE_MIN_SPEAKER_SIMILARITY=0.80
# JHADINA_SPEAKER_QC_URL=
# JHADINA_SPEAKER_QC_TOKEN=
# JHADINA_SPEAKER_QC_MODEL_ID=speechbrain/spkrec-ecapa-voxceleb
# JHADINA_SPEAKER_QC_MODEL_REVISION=ff989f88e92ccc120569763824f8eedd5afc9039
#
# Each admitted provider lane needs endpoint/token plus immutable provider binding.
# JHADINA_QWEN3_TTS_URL=
# JHADINA_QWEN3_TTS_TOKEN=
# JHADINA_QWEN3_TTS_LANGUAGES=en-US
# JHADINA_QWEN3_TTS_MODEL_ID=
# JHADINA_QWEN3_TTS_VOICE_REF=
# JHADINA_VOXCPM2_TTS_URL=
# JHADINA_VOXCPM2_TTS_TOKEN=
# JHADINA_VOXCPM2_TTS_LANGUAGES=en-US
# JHADINA_VOXCPM2_TTS_MODEL_ID=
# JHADINA_VOXCPM2_TTS_VOICE_REF=

# Artifact malware scanner and post-scan extraction services.
JHADINA_MEDIA_SCANNER_URL=
JHADINA_MEDIA_SCANNER_TOKEN=
JHADINA_ARTIFACT_EXTRACTOR_URL=
JHADINA_ARTIFACT_EXTRACTOR_TOKEN=


# Director character dataset / LoRA / video-upscale runtime.
# Production Jhadina must point at a worker whose /health reports productionReady=true.
DIRECTOR_CHARACTER_TRAINING_WORKER_URL=
DIRECTOR_CHARACTER_TRAINING_TOKEN=
# The runtime service itself uses these only when proxying real model/GPU executors:
# DIRECTOR_CHARACTER_DATASET_BACKEND_URL=
# DIRECTOR_CHARACTER_LORA_BACKEND_URL=
# DIRECTOR_VIDEO_UPSCALE_BACKEND_URL=

# Director autonomous Study worker. The worker must return evidence-bound
# observations through the callback contract; missing values fail closed.
JHADINA_DIRECTOR_STUDY_WORKER_URL=
JHADINA_DIRECTOR_STUDY_CALLBACK_URL=
JHADINA_DIRECTOR_STUDY_WORKER_TOKEN=

# Phantom-Wan subject-consistent shot/take renderer.
# This is a private worker boundary, not a generic whole-film endpoint.
# The worker must expose POST /v1/jobs, GET/DELETE /v1/jobs/:id and
# GET /v1/jobs/:id/artifact, preserve request/reference hashes, and return
# a model version + production runtime receipt for quality certification.
DIRECTOR_PHANTOM_WORKER_URL=
DIRECTOR_PHANTOM_WORKER_TOKEN=

# DIRECTOR-PRODUCTION.FINAL provider admission. Configuration alone never
# certifies quality; these flags merely allow the provider to enter the real
# quality-evidence path. Director still requires measured media + QC receipts.
DIRECTOR_COMFYUI_PRODUCTION_QUALITY_ELIGIBLE=false
DIRECTOR_COMFYUI_MAX_REFERENCE_IMAGES=
DIRECTOR_REFERENCE_VIDEO_PRODUCTION_QUALITY_ELIGIBLE=false
DIRECTOR_REFERENCE_VIDEO_MAX_REFERENCE_IMAGES=
DIRECTOR_PRODUCT_VIDEO_PRODUCTION_QUALITY_ELIGIBLE=false
DIRECTOR_PRODUCT_VIDEO_MAX_REFERENCE_IMAGES=
DIRECTOR_AGNES_VIDEO_PRODUCTION_QUALITY_ELIGIBLE=false

# Canonical per-shot Phantom generation is opt-in separately from the worker
# endpoint. Enabling it also requires an admitted/attested Phantom runtime
# model bundle in the Director generation factory.
DIRECTOR_PHANTOM_CANONICAL_GENERATION_ENABLED=false
DIRECTOR_PHANTOM_PROVIDER_ID=phantom-wan

# Explicit cross-identity capabilities and duration ceilings for whole-video
# providers. Leave unset/false unless the deployed workflow was actually
# verified to preserve the corresponding reference class.
DIRECTOR_COMFYUI_SUPPORTS_PRODUCT_REFERENCE=false
# Canonical Jhadina narration is separate from style/expression guidance.
# Set true only when the deployed workflow actually consumes the exact
# speakerIdentityRef and routes narration through the approved Jhadina voice path.
DIRECTOR_COMFYUI_SUPPORTS_CANONICAL_NARRATION=false
DIRECTOR_REFERENCE_VIDEO_SUPPORTS_PRODUCT_REFERENCE=false
DIRECTOR_REFERENCE_VIDEO_SUPPORTS_CANONICAL_NARRATION=false
DIRECTOR_PRODUCT_VIDEO_SUPPORTS_CANONICAL_NARRATION=false
DIRECTOR_AGNES_VIDEO_SUPPORTS_CANONICAL_NARRATION=false
DIRECTOR_REFERENCE_VIDEO_MAX_DURATION_SECONDS=
DIRECTOR_PRODUCT_VIDEO_MAX_DURATION_SECONDS=

# HunyuanVideo-1.5 governed shot/take renderer.
# Recommended first live target: Runpod Secure Cloud RTX 4090/A6000-class Pod.
# The worker must expose /health and /v1/jobs, preserve model/reference hashes,
# and return a production runtime receipt. Worker success still does not certify
# cinematic quality by itself.
DIRECTOR_HUNYUAN_WORKER_URL=
DIRECTOR_HUNYUAN_WORKER_TOKEN=
DIRECTOR_HUNYUAN_CANONICAL_GENERATION_ENABLED=false
DIRECTOR_HUNYUAN_PROVIDER_ID=hunyuan-video-1.5
# Runtime/checkpoint version returned in receipts.
HUNYUAN_VIDEO_MODEL_VERSION=HunyuanVideo-1.5
